{
  "name": "@asterdoc/render",
  "version": "0.9.0",
  "description": "Focused text, PDF, and DOCX rendering for Asterdoc",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js",
      "default": "./dist/text.js"
    },
    "./text/field-formatter": {
      "types": "./dist/text/field-formatter.d.ts",
      "import": "./dist/text/field-formatter.js",
      "default": "./dist/text/field-formatter.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js",
      "default": "./dist/pdf.js"
    },
    "./docx": {
      "types": "./dist/docx.d.ts",
      "import": "./dist/docx.js",
      "default": "./dist/docx.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "asterdoc",
    "documents",
    "rendering",
    "pdf",
    "docx",
    "markdown"
  ],
  "license": "MIT",
  "author": {
    "name": "Asterdoc",
    "url": "https://asterdoc.com"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/asterdoc/asterdoc.git",
    "directory": "packages/render"
  },
  "homepage": "https://asterdoc.com",
  "bugs": {
    "url": "https://github.com/asterdoc/asterdoc/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prebuild": "pnpm run clean",
    "pack:dry": "pnpm run build && npm pack --dry-run",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "check": "pnpm lint && pnpm check-types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark": "pnpm --silent run build >/dev/null && node scripts/benchmark.mjs",
    "size-report": "pnpm --silent run build >/dev/null && node scripts/size-report.mjs"
  },
  "peerDependencies": {
    "@asterdoc/types": "workspace:^"
  },
  "dependencies": {
    "@asterdoc/expr": "workspace:^",
    "@asterdoc/format": "workspace:^",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@asterdoc/eslint-config": "workspace:*",
    "@asterdoc/types": "workspace:^",
    "@asterdoc/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "^0.27.2",
    "eslint": "catalog:",
    "pdfjs-dist": "4.10.38",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

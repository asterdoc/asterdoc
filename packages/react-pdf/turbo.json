{
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	"tasks": {
		"test": {
			// `tests/pdf-class-vocabulary-docs.test.ts` and
			// `tests/skill-example-classes.test.ts` read the `asterdoc-react` skill
			// from outside this package, and `$TURBO_DEFAULT$` only tracks files
			// under the package's own directory. Without this, a commit that
			// touches only the skill would replay a cached pass instead of
			// re-running the comparison. The tests also render the sample documents
			// from `@asterdoc/components` source and drive a session through
			// `@asterdoc/react`'s test driver, so those count as inputs too.
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/framework/packages/components/src/**",
				"$TURBO_ROOT$/framework/packages/react/tests/session-driver.ts",
				"$TURBO_ROOT$/framework/skills/skills/asterdoc-react/SKILL.md",
				"$TURBO_ROOT$/framework/skills/skills/asterdoc-react/references/**"
			]
		}
	}
}

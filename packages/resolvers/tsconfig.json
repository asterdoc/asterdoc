{
  "extends": "../typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@asterdoc/resolvers/fs": ["src/fs/index.ts"],
      "@asterdoc/resolvers/http": ["src/http/index.ts"],
      "@asterdoc/resolvers/memory": ["src/memory/index.ts"]
    }
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist"]
}

{
  "name": "@asterdoc/components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "registry:build": "tsx scripts/build-registry.ts",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:registry": "vitest run --config vitest.registry.config.ts",
    "regenerate:annex": "tsx scripts/regenerate-annex.ts",
    "regenerate:styles": "tsx scripts/generate-shared-styles.ts"
  },
  "dependencies": {
    "@asterdoc/core": "workspace:^",
    "@asterdoc/essentials": "workspace:^",
    "@asterdoc/format": "workspace:^",
    "@asterdoc/react": "workspace:^",
    "@asterdoc/react-pdf": "workspace:^",
    "@asterdoc/types": "workspace:^",
    "qrcode.react": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@asterdoc/typescript-config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@takumi-rs/helpers": "catalog:",
    "jsqr": "catalog:",
    "pdfjs-dist": "catalog:",
    "puppeteer": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./examples": "./src/examples/index.ts",
    "./examples/pdf": "./src/examples/pdf.ts",
    "./examples/proposal-logo.png": "./src/examples/proposal-logo.png",
    "./examples/certificate-of-insurance.pdf": "./src/examples/certificate-of-insurance.pdf",
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": [
    "*.css"
  ]
}

{
  "name": "@asterdoc/format",
  "version": "0.9.0",
  "description": "Locale-aware presentation formatting for Asterdoc artifact values",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "asterdoc",
    "forms",
    "formatting",
    "locale",
    "internationalization"
  ],
  "license": "MIT",
  "author": {
    "name": "Asterdoc",
    "url": "https://asterdoc.com"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/asterdoc/asterdoc.git",
    "directory": "packages/format"
  },
  "homepage": "https://asterdoc.com",
  "bugs": {
    "url": "https://github.com/asterdoc/asterdoc/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prebuild": "pnpm run clean",
    "pack:dry": "pnpm run build && npm pack --dry-run",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "check": "pnpm lint && pnpm check-types",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "pnpm --silent run build >/dev/null && node scripts/benchmark.mjs"
  },
  "dependencies": {
    "@asterdoc/types": "workspace:^"
  },
  "devDependencies": {
    "@asterdoc/eslint-config": "workspace:*",
    "@asterdoc/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

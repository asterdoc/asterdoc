{
  "name": "@asterdoc/sdk",
  "version": "0.9.0",
  "description": "Umbrella package for the Asterdoc framework: re-exports @asterdoc/core, @asterdoc/format, and @asterdoc/sessions, plus the layer renderer, PDF placement helpers, and hosted sealing",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "asterdoc",
    "sdk",
    "forms",
    "rendering",
    "schemas",
    "validation"
  ],
  "license": "MIT",
  "author": {
    "name": "Asterdoc",
    "url": "https://asterdoc.com"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/asterdoc/asterdoc.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://asterdoc.com",
  "bugs": {
    "url": "https://github.com/asterdoc/asterdoc/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prebuild": "pnpm run clean",
    "pack:dry": "pnpm run build && npm pack --dry-run",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "check": "pnpm lint && pnpm check-types",
    "test": "vitest run"
  },
  "dependencies": {
    "@asterdoc/core": "workspace:*",
    "@asterdoc/format": "workspace:*",
    "@asterdoc/render": "workspace:*",
    "@asterdoc/sessions": "workspace:*"
  },
  "devDependencies": {
    "@asterdoc/eslint-config": "workspace:*",
    "@asterdoc/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

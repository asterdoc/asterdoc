  "keywords": [
    "asterdoc",
    "cli",
    "forms",
    "documents-as-code",
    "command-line"
  ],
  "license": "MIT",
  "author": "Asterdoc",
  "engines": {
    "node": ">=22"
  },
  "repository": {

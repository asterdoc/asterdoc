{
  "name": "@asterdoc/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:changelog": "tsx scripts/sync-changelog.ts",
    "changelog:draft": "tsx scripts/changelog-draft.ts",
    "sync:component-docs": "tsx scripts/sync-component-docs-content.ts",
    "sync:skills": "tsx ../../packages/agent-discovery/scripts/generate-skills.ts ../../skills/skills public/.well-known/agent-skills",
    "sync": "pnpm sync:changelog && pnpm sync:component-docs && pnpm sync:skills",
    "predev": "pnpm sync",
    "dev": "vite dev --port 3001",
    "prebuild": "pnpm sync",
    "build": "vite build",
    "preview": "vite preview --port 3001",
    "deploy:prod": "ASTERDOC_DOCS_PLATFORM_API=false WEB_ANALYTICS=on pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint": "biome lint",
    "precheck-types": "pnpm sync",
    "check-types": "tsc --noEmit",
    "check": "pnpm lint && pnpm check-types",
    "pretest": "pnpm sync",
    "test": "vitest run",
    "test:watch": "vitest",
    "health": "./scripts/health.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@asterdoc/agent-discovery": "workspace:*",
    "@asterdoc/components": "workspace:^",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.15.13",
    "fumadocs-mdx": "^15.4.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.15.13",
    "lucide-react": "catalog:",
    "pdfjs-dist": "catalog:",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "catalog:",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^5.1.4",
    "workers-og": "^0.0.27",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@cloudflare/vite-plugin": "^1.22.0",
    "@mdx-js/mdx": "^3.1.1",
    "@asterdoc/core": "workspace:*",
    "@asterdoc/render": "workspace:*",
    "@asterdoc/resolvers": "workspace:*",
    "@asterdoc/schemas": "workspace:*",
    "@asterdoc/sdk": "workspace:*",
    "@asterdoc/types": "workspace:*",
    "@types/mdx": "^2.0.13",
    "@types/node": "catalog:",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "catalog:",
    "remark-gfm": "^4.0.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "^7.3.7",
    "vitest": "catalog:",
    "wrangler": "^4.61.0"
  }
}
